# Postgres connection string used by the survey and newsletter actions.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Brevo (transactional/marketing email) — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Optional: list IDs to add contacts to. Numeric IDs from Brevo > Contacts > Lists.
# If omitted, contacts are still created/updated, just with no list assigned.
BREVO_NEWSLETTER_LIST_ID=
BREVO_SURVEY_LIST_ID=

# Cloudflare Turnstile (bot check on the newsletter + survey + contact forms)
# https://dash.cloudflare.com/?to=/:account/turnstile
# Secret key is server-only.
TURNSTILE_SECRET_KEY=
# Site key is public — exposed to the browser. Must be prefixed PUBLIC_ to be
# readable client-side by SvelteKit.
PUBLIC_TURNSTILE_SITE_KEY=

# Contact form: address messages are sent to (and sent from, via Brevo) —
# must already be a verified sender in Brevo.
CONTACT_EMAIL=
