# Postgres connection string used by the survey and newsletter actions.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Brevo (transactional/marketing email) — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Optional: list IDs to add contacts to. Numeric IDs from Brevo > Contacts > Lists.
# If omitted, contacts are still created/updated, just with no list assigned.
BREVO_NEWSLETTER_LIST_ID=
BREVO_SURVEY_LIST_ID=

# Cloudflare Turnstile (bot check on the newsletter + survey + contact forms)
# https://dash.cloudflare.com/?to=/:account/turnstile
# Secret key is server-only.
TURNSTILE_SECRET_KEY=
# Site key is public — exposed to the browser. Must be prefixed PUBLIC_ to be
# readable client-side by SvelteKit.
PUBLIC_TURNSTILE_SITE_KEY=

# Contact form: address messages are sent to (and sent from, via Brevo) —
# must already be a verified sender in Brevo.
CONTACT_EMAIL=

# Self-hosted Umami analytics. Not a secret — the script URL and website ID
# are always visible in the page source once loaded — kept in env just to
# make it easy to swap instances between environments. If either is unset,
# the tracking script is simply omitted.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# Cross-site links and attribution (survey site <-> services site).
# Base URL of the site that hosts /survey, no trailing slash. Leave blank on the
# survey site itself; set it on the services site, e.g. https://muscar.app
SURVEY_SITE_URL=
# Optional parent domain for the UTM attribution cookie, so a campaign click on
# one site is still credited when the visitor converts on the other. Set the
# same value on both sites, e.g. .muscar.app. Leave blank for host-only cookies.
COOKIE_DOMAIN=
